---
import { site, nav } from '../data/site';

interface Props {
  active?: 'home' | 'blog';
}

const { active = 'home' } = Astro.props;

// On the home page the section links are in-page anchors; everywhere else they
// have to travel back to the home page first.
const prefix = active === 'home' ? '' : '/';
const brandHref = active === 'home' ? '#top' : '/';
---

<header
  style="position:sticky;top:0;z-index:20;background:var(--color-bg);border-bottom:1px solid var(--color-divider)"
>
  <nav
    aria-label="Main"
    class="navwrap"
    style="max-width:1180px;margin:0 auto;padding:14px 36px;display:flex;align-items:center;gap:18px 30px"
  >
    <a
      href={brandHref}
      class="navbrand"
      style="font-family:var(--font-heading);font-weight:600;font-size:21px;letter-spacing:.02em;text-transform:uppercase;color:var(--color-text);text-decoration:none;margin-right:auto"
      >{site.name}</a
    >

    <div
      class="navlinks"
      style="display:flex;align-items:center;gap:26px;font-family:var(--font-heading);font-weight:600;font-size:15px;letter-spacing:.1em;text-transform:uppercase"
    >
      {
        nav.map((item) => (
          <a href={`${prefix}${item.href}`} style="color:var(--color-text);text-decoration:none">
            {item.label}
          </a>
        ))
      }
      <a
        href="/blog"
        aria-current={active === 'blog' ? 'page' : undefined}
        style={
          active === 'blog'
            ? 'color:var(--color-accent-800);text-decoration:none'
            : 'color:var(--color-text);text-decoration:none'
        }>Blog</a
      >
    </div>

    <button type="button" class="themebtn" data-theme-toggle aria-label="Switch theme" title="Switch theme">
      <svg
        data-theme-icon="dark"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
        ></path>
      </svg>
      <svg
        data-theme-icon="light"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
      </svg>
    </button>

    {
      active === 'home' ? (
        <a
          class="btn btn-primary cvbtn"
          href={site.cv}
          download={site.cvFilename}
          style="flex:none;font-size:15px;letter-spacing:.08em;text-transform:uppercase;padding:9px 18px"
        >
          Download CV
        </a>
      ) : (
        <a
          class="btn btn-primary cvbtn"
          href={`mailto:${site.email}`}
          style="flex:none;font-size:15px;letter-spacing:.08em;text-transform:uppercase;padding:9px 18px"
        >
          Email me
        </a>
      )
    }
  </nav>

  <div aria-hidden="true" style="height:2px;background:color-mix(in srgb,var(--color-text) 8%,transparent)">
    <span class="tick" data-progress></span>
  </div>
</header>
