---
import { profile } from '../data/site';

interface Props { active?: 'writing'; progress?: boolean }
const { active, progress } = Astro.props;

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#capabilities', label: 'Skills' },
  { href: '/#credentials', label: 'Credentials' },
  { href: '/blog', label: 'Writing', key: 'writing' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label={`${profile.name} — home`}>
      <span class="brand__mark" aria-hidden="true">AH</span>
      <span>{profile.handle}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={l.key && l.key === active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
  {progress && <div class="read-progress" data-read-progress aria-hidden="true"></div>}
</header>
