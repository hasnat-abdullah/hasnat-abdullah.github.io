---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
import pic from '../assets/pic.jpeg';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  active?: 'writing';
  type?: 'website' | 'article';
  published?: Date;
  jsonLd?: Record<string, unknown>;
  progress?: boolean;
}

const { title, description = profile.description, active, type = 'website', published, jsonLd, progress = false } = Astro.props;
// build.format "file" makes pathname end in .html; canonical URLs use the extensionless form GitHub Pages serves.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
const ogImage = new URL((await getImage({ src: pic, width: 1200, format: 'jpg' })).src, Astro.site);

// GitHub Pages can't send response headers, so the policy ships as a meta tag (prod only: the dev server injects inline scripts).
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  'upgrade-insecure-requests',
].join('; ');

// Escape "<" so content can never close the JSON-LD script element.
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#F4F6F5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Writing`} href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={profile.name} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header active={active} progress={progress} />
    <div id="content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
